<div class="trips-page">

  <div class="trips-container">

    <!-- HEADER -->

    <div class="trips-header">

      <div>
        <span class="trips-badge">✦ Your adventures</span>

        <h1>My Trips</h1>

        <p>
          All your adventures in one place.
        </p>
      </div>

      <%= link_to "＋ Create new trip",
                  new_trip_path,
                  class: "create-button" %>

    </div>


    <!-- TRIPS -->

    <% if @trips.any? %>

      <div class="trips-grid">

        <% @trips.each do |trip| %>

          <div class="trip-card">

            <div class="trip-card-top">

              <div class="trip-icon">
                ✈️
              </div>

              <span class="trip-status">
                Planned
              </span>

            </div>


            <h2>
              <%= trip.title %>
            </h2>


            <p class="trip-description">
              <%= trip.description %>
            </p>


            <div class="trip-info">

              <div class="info-item">
                <span class="info-icon">📅</span>

                <div>
                  <small>Dates</small>

                  <p>
                    <%= trip.start_date.strftime("%d %b %Y") %>
                    –
                    <%= trip.end_date.strftime("%d %b %Y") %>
                  </p>
                </div>
              </div>


              <div class="info-item">
                <span class="info-icon">💰</span>

                <div>
                  <small>Budget</small>

                  <p>
                    €<%= trip.budget %>
                  </p>
                </div>
              </div>

            </div>


            <%= link_to trip_path(trip),
                        class: "view-trip-button" do %>

              View trip
              <span>→</span>

            <% end %>

          </div>

        <% end %>

      </div>


    <% else %>

      <!-- EMPTY STATE -->

      <div class="empty-state">

        <div class="empty-icon">
          🌎
        </div>

        <h2>
          Your next adventure starts here.
        </h2>

        <p>
          You haven't created any trips yet.
          Let Travelscape help you plan your next adventure.
        </p>

        <%= link_to "Create your first trip →",
                    new_trip_path,
                    class: "create-button" %>

      </div>

    <% end %>

  </div>

</div>


<style>

  /* PAGE */

  .trips-page {
    min-height: 100vh;
    background: #f6f8f7;
    padding: 70px 20px;
  }


  .trips-container {
    max-width: 1150px;
    margin: 0 auto;
  }


  /* HEADER */

  .trips-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 45px;
  }


  .trips-badge {
    display: inline-block;
    background: #e7f3ee;
    color: #267a5b;
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 15px;
  }


  .trips-header h1 {
    font-size: 52px;
    font-weight: 700;
    letter-spacing: -2px;
    color: #17221e;
    margin: 0 0 8px;
  }


  .trips-header p {
    color: #6b756f;
    font-size: 17px;
    margin: 0;
  }


  /* CREATE BUTTON */

  .create-button {
    display: inline-block;
    background: #17221e;
    color: white;
    padding: 14px 22px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }


  .create-button:hover {
    background: #267a5b;
    color: white;
    transform: translateY(-2px);
  }


  /* GRID */

  .trips-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }


  /* CARD */

  .trip-card {
    background: white;
    padding: 28px;
    border-radius: 22px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.05);
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
  }


  .trip-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.09);
  }


  .trip-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
  }


  .trip-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #e7f3ee;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 23px;
  }


  .trip-status {
    font-size: 12px;
    font-weight: 600;
    color: #267a5b;
    background: #edf8f3;
    padding: 6px 10px;
    border-radius: 20px;
  }


  .trip-card h2 {
    font-size: 24px;
    color: #17221e;
    margin-bottom: 10px;
  }


  .trip-description {
    color: #6b756f;
    line-height: 1.5;
    margin-bottom: 25px;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }


  /* INFO */

  .trip-info {
    border-top: 1px solid #edf0ee;
    padding-top: 20px;
    margin-bottom: 25px;
  }


  .info-item {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 15px;
  }


  .info-icon {
    width: 35px;
    height: 35px;
    border-radius: 10px;
    background: #f5f7f6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }


  .info-item small {
    display: block;
    color: #8a938e;
    font-size: 12px;
    margin-bottom: 2px;
  }


  .info-item p {
    margin: 0;
    color: #29342f;
    font-size: 14px;
    font-weight: 600;
  }


  /* VIEW BUTTON */

  .view-trip-button {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f5f7f6;
    color: #17221e;
    padding: 13px 16px;
    border-radius: 11px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }


  .view-trip-button:hover {
    background: #17221e;
    color: white;
  }


  .view-trip-button span {
    font-size: 18px;
  }


  /* EMPTY STATE */

  .empty-state {
    background: white;
    border-radius: 24px;
    padding: 80px 30px;
    text-align: center;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.05);
  }


  .empty-icon {
    font-size: 60px;
    margin-bottom: 20px;
  }


  .empty-state h2 {
    font-size: 30px;
    color: #17221e;
    margin-bottom: 12px;
  }


  .empty-state p {
    max-width: 500px;
    margin: 0 auto 30px;
    color: #6b756f;
    line-height: 1.6;
  }


  /* MOBILE */

  @media (max-width: 900px) {

    .trips-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }


  @media (max-width: 650px) {

    .trips-page {
      padding: 40px 15px;
    }

    .trips-header {
      display: block;
    }

    .trips-header h1 {
      font-size: 42px;
    }

    .create-button {
      margin-top: 25px;
    }

    .trips-grid {
      grid-template-columns: 1fr;
    }

  }

</style>
