<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">

      <h1 class="mb-4">Edit your itinerary ✏️</h1>

      <%= form_with url: trip_itinerary_path(@trip), method: :patch do %>

        <% @itinerary_days.each do |day| %>

          <div class="card shadow-sm mb-4">
            <div class="card-body">

              <h2 class="h4">
                Day <%= day.day_number %> — <%= day.title %>
              </h2>

              <p class="text-muted">
                <%= day.date.strftime("%d %B %Y") %>
              </p>

              <hr>

              <% day.activities.each do |activity| %>

                <div class="border rounded p-3 mb-3">

                  <h3 class="h5">
                    <%= activity.location %>
                  </h3>

                  <div class="row">

                    <div class="col-md-4">
                      <%= label_tag "activities_#{activity.id}_start_time",
                                    "Start time" %>

                      <%= time_field_tag "activities[#{activity.id}][start_time]",
                                         activity.start_time&.strftime("%H:%M"),
                                         class: "form-control" %>
                    </div>

                    <div class="col-md-4">
                      <%= label_tag "activities_#{activity.id}_end_time",
                                    "End time" %>

                      <%= time_field_tag "activities[#{activity.id}][end_time]",
                                         activity.end_time&.strftime("%H:%M"),
                                         class: "form-control" %>
                    </div>

                    <div class="col-md-4">
                      <%= label_tag "activities_#{activity.id}_estimated_cost",
                                    "Cost (€)" %>

                      <%= number_field_tag "activities[#{activity.id}][estimated_cost]",
                                           activity.estimated_cost,
                                           min: 0,
                                           step: 0.01,
                                           class: "form-control" %>
                    </div>

                  </div>

                  <div class="mt-3">
                    <%= label_tag "activities_#{activity.id}_location",
                                  "Location" %>

                    <%= text_field_tag "activities[#{activity.id}][location]",
                                       activity.location,
                                       class: "form-control" %>
                  </div>

                </div>

              <% end %>

            </div>
          </div>

        <% end %>

        <%= submit_tag "Save itinerary",
                       class: "btn btn-success" %>

        <%= link_to "Back to trip",
                    trip_path(@trip),
                    class: "btn btn-secondary ms-2" %>

      <% end %>

    </div>
  </div>
</div>
