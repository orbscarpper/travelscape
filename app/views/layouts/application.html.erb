<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Travelscape" %></title>

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Travelscape">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- Mapbox CSS -->
    <link
      href="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.css"
      rel="stylesheet"
    >

    <!-- Mapbox JavaScript -->
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.js"></script>

    <%= javascript_importmap_tags %>
  </head>

  <body>

    <!-- NAVBAR -->
    <nav class="navbar">

      <%= link_to "Travelscape", root_path, class: "navbar-logo" %>

      <div class="navbar-links">

        <%= link_to "Home", root_path %>

        <% if user_signed_in? %>

          <%= link_to "My Trips", trips_path %>

          <%= link_to "New Trip", new_trip_path %>

          <%= link_to "Log out",
                      destroy_user_session_path,
                      data: { turbo_method: :delete } %>

        <% else %>

          <%= link_to "Log in", new_user_session_path %>

          <%= link_to "Sign up", new_user_registration_path %>

        <% end %>

      </div>

    </nav>


    <!-- FLASH MESSAGES -->
    <% flash.each do |type, message| %>
      <div class="alert alert-<%= type.to_s == "alert" ? "danger" : "success" %> alert-dismissible fade show"
           role="alert">
        <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>


    <!-- PAGE CONTENT -->
    <main>
      <%= yield %>
    </main>

  </body>
</html>
